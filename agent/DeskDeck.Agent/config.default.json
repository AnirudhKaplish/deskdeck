{
  // DeskDeck settings. Easiest to edit from the tray icon > Settings (http://127.0.0.1:8765).
  // Manual edits are picked up on the next request; no restart needed.

  // Only use the phone with this serial number (null = every connected Android device)
  "deviceSerial": null,
  // Path to adb.exe (null = searched in PATH, the Android SDK and winget locations)
  "adbPath": null,

  // Weather location (Open-Meteo, no API key required)
  "weather": { "city": "Delhi", "lat": 28.6139, "lon": 77.209 },

  // Ping target for the ping metric and the "ping high" rule, every 5 s (empty = off)
  "ping": { "host": "1.1.1.1", "adapters": [] },
  // Discord widget: talks to the Discord desktop app on this computer. Create an application at discord.com/developers/applications, add the redirect http://127.0.0.1, and enter its client ID and secret (see docs/DISCORD.md)
  "discord": { "enabled": false, "clientId": null, "clientSecret": null },
  // App console widget (Windows): keys and dial bindings per app, matched by the focused window's process name
  "console": { "profiles": [] },

  // Night mode: between these times the screen dims and only the clock stays. Tap to wake it for 30 s.
  "night": { "enabled": true, "start": "00:30", "end": "07:30", "brightness": 0.02 },

  // Clock seconds, return to the first page after N idle seconds (0 = never), vibrate on session events,
  // switch pages with the phone's volume keys
  "display": { "showSeconds": true, "idleReturnSec": 90, "vibrate": true, "volumeKeys": true, "pixelShift": false, "controlsTop": false, "idleDimMin": 0, "language": "auto" },

  // Photo frame widget: the folder its slideshow shows (empty = off) and whether subfolders count
  "photos": { "folder": "", "subfolders": true },

  // Pages in the order they appear on the phone. Each page is a 12 x 6 grid of widgets; the settings page has a
  // visual editor. { "template": "<id>" } creates a page from templates.json (home, ai, work, system, procs, deck,
  // music, clock, focus, world, dashboard, devops, feeds, ambient, markets, daily, status, calm) and is replaced by
  // its widgets on the first save.
  "pages": [
    { "template": "home" },
    { "template": "ai" },
    { "template": "work" },
    { "template": "system" },
    { "template": "procs" },
    { "id": "deck", "title": "Shortcuts", "icon": "\ud83c\udf9b\ufe0f", "widgets": [
      { "id": "shortcuts-apps", "type": "shortcuts", "x": 0, "y": 0, "w": 12, "h": 2, "options": { "columns": 6, "ids": ["claude-code", "terminal", "explorer", "vscode", "browser", "spotify"] } },
      { "id": "bright-phone", "type": "brightbar", "x": 0, "y": 2, "w": 12, "h": 1, "options": { "target": "phone" } },
      { "id": "bright-pc", "type": "brightbar", "x": 0, "y": 3, "w": 12, "h": 1, "options": { "target": "pc" } },
      { "id": "shortcuts-system", "type": "shortcuts", "x": 0, "y": 4, "w": 12, "h": 2, "options": { "columns": 6, "ids": ["settings", "snip", "taskmgr", "mute", "monitoroff", "lock"] } }
    ] },
    { "template": "music" },
    { "template": "focus", "enabled": false },
    { "template": "world", "enabled": false }
  ],

  // Shortcut keys. The phone only sends the "id"; commands live in this file only.
  // cmd: a program, a URL / shell: / ms-settings: address, or builtin:lock | builtin:monitor-off | builtin:mute
  "shortcuts": [
    { "id": "claude-code", "label": "Claude Code",  "icon": "\ud83e\udd16", "color": "#d97757", "cmd": "powershell.exe", "args": "-NoExit -Command claude" },
    { "id": "terminal",   "label": "Terminal",     "icon": "\u2328\ufe0f", "color": "#64748b", "cmd": "wt.exe" },
    { "id": "explorer",   "label": "Files",        "icon": "\ud83d\udcc1", "color": "#64748b", "cmd": "explorer.exe" },
    { "id": "vscode",     "label": "VS Code",      "icon": "\ud83d\udcdd", "color": "#64748b", "cmd": "shell:AppsFolder\\Microsoft.VisualStudioCode" },
    { "id": "browser",    "label": "Browser",      "icon": "\ud83c\udf10", "color": "#64748b", "cmd": "https://github.com" },
    { "id": "spotify",    "label": "Spotify",      "icon": "\ud83c\udfa7", "color": "#64748b", "cmd": "shell:AppsFolder\\SpotifyAB.SpotifyMusic_zpdnekdrzrea0!Spotify" },
    { "id": "settings",   "label": "Settings",     "icon": "\u2699\ufe0f", "color": "#64748b", "cmd": "ms-settings:" },
    { "id": "snip",       "label": "Snip",         "icon": "\u2702\ufe0f", "color": "#64748b", "cmd": "ms-screenclip:" },
    { "id": "taskmgr",    "label": "Task Mgr",     "icon": "\ud83d\udcca", "color": "#64748b", "cmd": "taskmgr.exe" },
    { "id": "mute",       "label": "Mute",         "icon": "\ud83d\udd07", "color": "#64748b", "cmd": "builtin:mute" },
    { "id": "monitoroff", "label": "Screen Off",   "icon": "\ud83c\udf19", "color": "#64748b", "cmd": "builtin:monitor-off" },
    { "id": "lock",       "label": "Lock",         "icon": "\ud83d\udd12", "color": "#64748b", "cmd": "builtin:lock" }
  ]
}
